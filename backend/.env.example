# =================================================================
# Backend Environment Configuration
# =================================================================

# Server Port (Default: 4000)
PORT=4000
NODE_ENV=development

# MongoDB Connection String (Base URL - backend appends /temple)
# Local: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# JWT Secret Key for token generation and verification
JWT_SECRET=your_jwt_secret_key_change_in_production

# Cloudinary Credentials (for temple images, pooja photos, uploads)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

# Razorpay Credentials (Test keys for local testing)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Admin Credentials (Used for Admin OTP Login verification)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_optional

# Nodemailer / Email Service (Gmail SMTP with App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Allowed Client Origins for CORS (Optional for localhost, required for prod)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Google OAuth 2.0 (Optional - for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
